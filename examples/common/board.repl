// STM32F4 Discovery as used by the tutorial.
//
// Renode's stock description only wires the green LED (PD12). The real board
// also has orange PD13, red PD14 and blue PD15, so add them here.

using "platforms/boards/stm32f4_discovery-kit.repl"

OrangeLED: Miscellaneous.LED @ gpioPortD
RedLED: Miscellaneous.LED @ gpioPortD
BlueLED: Miscellaneous.LED @ gpioPortD

gpioPortD:
    13 -> OrangeLED@0
    14 -> RedLED@0
    15 -> BlueLED@0

// After reset APB1 runs at 16 MHz (HSI, prescaler /1), so TIM2-TIM5 count at
// 16 MHz. Set it at construction time: the compare channels inherit it.
timer2:
    frequency: 16000000

timer3:
    frequency: 16000000

timer4:
    frequency: 16000000

timer5:
    frequency: 16000000

// Renode routes pin N of every port straight to EXTI line N and has no SYSCFG
// model. Back SYSCFG with plain memory so EXTICR writes read back like on silicon.
syscfg: Memory.ArrayMemory @ sysbus 0x40013800
    size: 0x400

// ---- Additions for lessons 16-25 ------------------------------------------

// USART2 requests DMA1 stream 6 (USART2_TX, channel 4).
usart2:
    DMARequest -> dma1@6

// ADC1 (register compatible with the F7 model). Its DMA request goes to
// DMA2 stream 0 (ADC1, channel 0).
adc1: Analog.STM32_ADC @ sysbus 0x40012000
    IRQ -> nvic@18
    DMARequest -> dma2@0

// RTC wakeup timer -> EXTI line 22 -> RTC_WKUP_IRQn (3).
rtc:
    WakeupIRQ -> exti@22

// Si7021 temperature / humidity sensor on I2C1 (PB6 SCL, PB7 SDA), address 0x40.
si7021: Sensors.SI70xx @ i2c1 0x40
    model: Model.SI7021

// 16 MB SPI NOR flash on SPI2 (PB13 SCK, PB14 MISO, PB15 MOSI), chip select PB12.
spiflash: SPI.Micron_MT25Q @ spi2
    underlyingMemory: spiflash_mem

spiflash_mem: Memory.MappedMemory @ none
    size: 0x1000000

gpioPortB:
    12 -> spiflash@0

// Renode has no STM32F4 DAC model: this one copies DHR12R1 to DOR1 when
// channel 1 is enabled (software trigger or no trigger) and logs the voltage.
dac: Python.PythonPeripheral @ sysbus 0x40007400
    size: 0x400
    initable: true
    script: '''
if request.IsInit:
    regs = {}
elif request.IsRead:
    request.Value = regs.get(request.Offset, 0)
elif request.IsWrite:
    off = request.Offset
    val = request.Value
    if off == 0x04:
        if (val & 1) and (regs.get(0x00, 0) & 1):
            regs[0x2C] = regs.get(0x08, 0) & 0xFFF
            self.InfoLog("DAC1 out = %d (%.3f V)" % (regs[0x2C], regs[0x2C] * 3.3 / 4095))
    else:
        regs[off] = val
        cr = regs.get(0x00, 0)
        if off in (0x00, 0x08) and (cr & 1) and not (cr & 4):
            regs[0x2C] = regs.get(0x08, 0) & 0xFFF
            self.InfoLog("DAC1 out = %d (%.3f V)" % (regs[0x2C], regs[0x2C] * 3.3 / 4095))
'''
